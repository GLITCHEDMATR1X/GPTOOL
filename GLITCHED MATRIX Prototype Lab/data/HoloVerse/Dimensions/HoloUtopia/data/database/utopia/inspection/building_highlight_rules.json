{
  "schema": 1,
  "id": "holoutopia_building_highlight_rules_v1",
  "runtime_writes_allowed": false,
  "description": "Authoritative rules for selecting HoloUtopia buildings and loading only the highlighted interior.",
  "selection_priority": [
    "residential_lot",
    "district_block"
  ],
  "highlight_modes": {
    "residential_lot": {
      "show_panel": true,
      "show_residents": true,
      "show_workers": true,
      "show_capacity": true,
      "allow_lazy_interior_load": true,
      "default_outline": "residential_highlight"
    },
    "district_block": {
      "show_panel": true,
      "show_residents": true,
      "show_workers": true,
      "show_capacity": true,
      "allow_lazy_interior_load": false,
      "default_outline": "district_highlight"
    }
  },
  "lazy_interior_contract": {
    "load_when": "building_is_highlighted",
    "unload_when": "selection_changes_or_panel_closes",
    "max_loaded_interiors": 1,
    "runtime_state_writes_allowed": false,
    "fallback_if_missing": "show_exterior_panel_only"
  },
  "visual_contract": {
    "foundation_first": true,
    "no_arbitrary_diagonals": true,
    "do_not_draw_underlay_lines_through_foundations": true,
    "interior_lines": "highlight_only",
    "panel_anchor": "screen_corner_or_building_billboard"
  }
}
