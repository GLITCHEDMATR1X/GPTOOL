{
  "schema_version": 1,
  "kind": "holoutopia_visual_model_kit_catalog",
  "rule": "All buildings are solid by default; selected buildings may become transparent cutaways.",
  "district_kits": {
    "civic_core": {
      "purpose": "portal/civic/governance structures",
      "features": [
        "civic plinth",
        "roof ring",
        "clean service windows"
      ]
    },
    "civic_commons": {
      "purpose": "education, recreation, gardens, public commons",
      "features": [
        "low civic plinths",
        "roof ring/garden cues"
      ]
    },
    "market_pavilion": {
      "purpose": "shops, vendors, food halls, public market activity",
      "features": [
        "front awnings",
        "sign modules",
        "public-facing window strips"
      ]
    },
    "security_watch": {
      "purpose": "guard, checkpoint, scanner, and surveillance blocks",
      "features": [
        "corner pylons",
        "roof mast",
        "scanner ring"
      ]
    },
    "industrial_bay": {
      "purpose": "production, repair, logistics, power and utility yards",
      "features": [
        "sawtooth roof",
        "service pipe",
        "roof mast"
      ]
    },
    "harbor_utility": {
      "purpose": "docks, ferry, water utility, cargo, rescue",
      "features": [
        "dock deck",
        "crane arm",
        "waterfront service strips"
      ]
    },
    "archive_stack": {
      "purpose": "archive, memory, vault, research, lore systems",
      "features": [
        "upper archive tier",
        "memory crown",
        "window bands"
      ]
    },
    "quarantine_containment": {
      "purpose": "glitched containment, decon, anomaly recovery",
      "features": [
        "corner containment pylons",
        "dampener mast",
        "scanner ring"
      ]
    },
    "residential_stack": {
      "purpose": "district residential and dorm structures",
      "features": [
        "balconies",
        "window bands",
        "entry cues"
      ]
    },
    "utility_service": {
      "purpose": "fallback utility/service buildings",
      "features": [
        "roof mast",
        "exterior bands"
      ]
    }
  },
  "residential_kits": {
    "micro_residence": {
      "purpose": "small home or pod house",
      "features": [
        "solid shell",
        "entry porch",
        "roof/service cue"
      ]
    },
    "courtyard_home": {
      "purpose": "family/courtyard home",
      "features": [
        "entry porch",
        "roof courtyard ring"
      ]
    },
    "residential_stack": {
      "purpose": "apartment/tower/stacked residence",
      "features": [
        "balconies",
        "window bands",
        "entry porch"
      ]
    },
    "residential_dorm": {
      "purpose": "workers, guards, staff, student housing",
      "features": [
        "regular exterior bands",
        "entry porch",
        "service cue"
      ]
    },
    "mixed_use_loft": {
      "purpose": "above-shop housing",
      "features": [
        "awning",
        "sign module",
        "loft window bands"
      ]
    }
  }
}