{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HoloUtopia Citizen Memory Event",
  "type": "object",
  "required": [
    "version",
    "citizen_id",
    "event_id",
    "timestamp",
    "kind",
    "summary"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "citizen_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "number"
    },
    "kind": {
      "type": "string",
      "enum": [
        "task",
        "social",
        "district",
        "home",
        "work",
        "player",
        "system"
      ]
    },
    "summary": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "related_citizen_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mood_delta": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "importance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "debug_source_id": {
      "type": "string"
    }
  }
}