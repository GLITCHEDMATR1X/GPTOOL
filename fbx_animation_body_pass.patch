+def discover_animation_clips():
+    clips = []
+    if ANIMATIONS_DIR.exists():
+        for path in sorted(ANIMATIONS_DIR.glob("*.fbx")):
+            clips.append({"name": path.stem, "path": path, "kind": "fbx"})
+    # The GLB base has an embedded idle animation. Keep it as a backup source, but
+    # prefer the FBX Idle clip when present so the numbered clip set stays consistent.
+    if CHARACTER_MESH.exists() and not any(c["name"].lower() == "idle" for c in clips):
+        clips.insert(0, {"name": "Idle", "path": CHARACTER_MESH, "kind": "glb"})
+    return clips
+
+
+def _clip_matches(requested, clip_name):
+    a = str(requested or "").strip().lower().replace("_", " ").replace("-", " ")
+    b = str(clip_name or "").strip().lower().replace("_", " ").replace("-", " ")
+    return a == b or a in b or b in a
+
+
+def _actor_tight_bounds(actor):
+    bounds = actor.getTightBounds()
+    if not bounds or bounds[0] is None or bounds[1] is None:
+        return None, None
+    return Vec3(bounds[0]), Vec3(bounds[1])
