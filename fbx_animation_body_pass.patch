+            self.cam_heading.setH(self.body_heading + 180.0)
+            self.cam_pitch.setP(-9.0)
+            self.status(f"Play Body mode ON. {self.body_clip_status}")
+        else:
+            if self.body_root is not None:
+                self.body_root.hide()
