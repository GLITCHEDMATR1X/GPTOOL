+    def _setup_animation_body(self):
+        self.body_root = self.scene_roots["character_world"].attachNewNode("animated_body_root")
+        self.body_root.setPos(0, 0, 0)
+        self.body_root.setH(self.body_heading)
+        self.body_root.hide()
+        if self.animation_clips:
+            idle_index = self._clip_index_for_name("Idle")
+            if idle_index >= 0:
+                self.current_clip_index = idle_index
+            self.body_clip_status = f"Animation clips ready: {len(self.animation_clips)} found. Toggle Play Body or press 1-0 to load."
+            if ARGS.play_body:
+                self.load_body_clip(ARGS.animation, announce=False)
+        else:
+            self.body_clip_status = "No FBX/GLB animation clips found in assets/character/animations."
+            _write_log(self.body_clip_status)
+
+    def _clip_index_for_name(self, requested):
+        if not self.animation_clips:
+            return -1
+        for index, clip in enumerate(self.animation_clips):
+            if _clip_matches(requested, clip["name"]):
+                return index
+        return 0
+
+    def _body_clip_number_text(self):
+        if not self.animation_clips:
+            return "No animation clips found."
+        parts = []
+        for idx, clip in enumerate(self.animation_clips[:10]):
+            key = "0" if idx == 9 else str(idx + 1)
+            parts.append(f"{key}:{clip['name']}")
+        return "  ".join(parts)
+
+    def _normalize_actor_to_body_root(self, actor, clip_kind):
+        # Mixamo FBX files import with the height on Panda Y. Roll them upright,
+        # then fit the body to the same authoring height as the editable GLB mesh.
+        actor.setHpr(0, 0, 90 if clip_kind == "fbx" else 0)
+        actor.setScale(1.0)
+        self.graphicsEngine.renderFrame()
+        min_v, max_v = _actor_tight_bounds(actor)
+        if min_v is None:
+            actor.setScale(1.0)
+            actor.setPos(0, 0, 0)
+            return
+        extent = max_v - min_v
+        max_extent = max(extent.x, extent.y, extent.z, 0.001)
+        actor.setScale(3.25 / max_extent)
+        self.graphicsEngine.renderFrame()
+        min_v, max_v = _actor_tight_bounds(actor)
+        if min_v is None:
+            return
+        center = (min_v + max_v) * 0.5
+        actor.setPos(-center.x, -center.y, -min_v.z)
+
+    def _style_body_actor(self, actor):
+        actor.clearTexture()
+        actor.setColor(0.88, 0.78, 0.62, 1.0)
+        mat = Material()
+        mat.setDiffuse((0.88, 0.78, 0.62, 1.0))
+        mat.setAmbient((0.55, 0.47, 0.36, 1.0))
+        mat.setSpecular((0.18, 0.16, 0.14, 1.0))
+        mat.setShininess(18.0)
+        actor.setMaterial(mat, 1)
+
+    def load_body_clip(self, requested=None, announce=True):
+        if not self.animation_clips:
+            self.body_clip_status = "No animation clips are available."
+            if announce:
+                self.status(self.body_clip_status)
+            return False
+        index = self._clip_index_for_name(requested) if not isinstance(requested, int) else int(requested) % len(self.animation_clips)
+        if index < 0:
+            return False
+        clip = self.animation_clips[index]
+        if self.body_actor is not None:
+            try:
+                self.body_actor.stop()
+                self.body_actor.cleanup()
+            except Exception:
+                pass
+            self.body_actor.removeNode()
+            self.body_actor = None
+        try:
+            actor = Actor(str(clip["path"]))
+            actor.reparentTo(self.body_root)
+            self._normalize_actor_to_body_root(actor, clip["kind"])
+            self._style_body_actor(actor)
+            names = actor.getAnimNames()
+            self.body_anim_name = names[0] if names else None
+            if self.body_anim_name:
+                actor.loop(self.body_anim_name)
+            self.body_actor = actor
+            self.current_clip_index = index
+            joint_count = len(actor.getJoints())
+            self.body_clip_status = f"Animated body: {clip['name']} ({clip['kind'].upper()}, {joint_count} joints)"
+            _write_log(self.body_clip_status)
+            if announce:
+                self.status(self.body_clip_status)
+            return True
+        except Exception as exc:
+            self.body_clip_status = f"Animation clip load failed for {clip['name']}: {exc}"
+            _write_log(self.body_clip_status)
+            if announce:
+                self.status(self.body_clip_status)
+            return False
+
+    def set_body_clip_by_index(self, index):
+        self.load_body_clip(index, announce=True)
+        if not self.body_mode:
+            self.enable_body_mode(True)
+        self._refresh_info_labels()
+
+    def cycle_body_clip(self, direction=1):
+        if not self.animation_clips:
+            self.status("No animation clips to cycle.")
+            return
