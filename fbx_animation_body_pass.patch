+
+    def toggle_body_mode(self):
+        self.enable_body_mode(not self.body_mode)
+
+    def pause_resume_body_animation(self):
+        if not self.body_actor or not self.body_anim_name:
+            self.status("No body animation loaded.")
+            return
+        self.body_paused = not self.body_paused
+        if self.body_paused:
+            self.body_actor.stop(self.body_anim_name)
+            self.status("Body animation paused.")
+        else:
+            self.body_actor.loop(self.body_anim_name)
+            self.status("Body animation resumed.")
+
+    def _try_autoplay_locomotion_clip(self, moving):
+        if (not self.autoplay_locomotion) or (not self.body_mode) or (not self.animation_clips):
+            return
+        current = self.animation_clips[self.current_clip_index]["name"].lower()
+        desired = None
+        if moving:
+            desired = "Sprint" if self.shift_down else "Walking"
+        elif current in ("walking", "sprint"):
+            desired = "Idle"
+        if desired and not _clip_matches(desired, self.animation_clips[self.current_clip_index]["name"]):
+            idx = self._clip_index_for_name(desired)
+            if idx >= 0:
+                self.load_body_clip(idx, announce=False)
+
+    def _do_body_controls(self, dt):
+        if not self.body_mode or self.body_root is None:
+            return False
+        turn = 0.0
+        if self.move_state["a"]:
+            turn += self.body_turn_speed * dt
+        if self.move_state["d"]:
+            turn -= self.body_turn_speed * dt
+        if turn:
+            self.body_heading += turn
+            self.body_root.setH(self.body_heading)
+        forward_amount = (1.0 if self.move_state["w"] else 0.0) - (1.0 if self.move_state["s"] else 0.0)
+        moving = abs(forward_amount) > 0.01
+        if moving:
+            speed = self.body_move_speed * (1.85 if self.shift_down else 1.0)
+            heading_rad = math.radians(self.body_heading)
+            step = Vec3(-math.sin(heading_rad), math.cos(heading_rad), 0) * (forward_amount * speed * dt)
+            pos = self.body_root.getPos() + step
+            pos.z = 0.0
+            self.body_root.setPos(pos)
+        self._try_autoplay_locomotion_clip(moving)
+        # Third-person follow camera. Mouse/arrow orbit still rotates the camera rig.
+        target = self.body_root.getPos() + Vec3(0, 0, 1.45)
+        current = self.cam_pivot.getPos()
+        self.cam_pivot.setPos(current + ((target - current) * clamp(dt * 8.0, 0.0, 1.0)))
+        return True
+
+    def _animation_text(self):
+        mode = "ON" if self.body_mode else "OFF"
+        clip = self.animation_clips[self.current_clip_index]["name"] if self.animation_clips else "None"
+        return (
+            f"Play Body: {mode}\n"
+            f"Clip: {clip}\n"
+            f"P toggles body, Space pauses\n"
+            f"1-0 clips, [/] cycles\n"
+            f"W/S move, A/D turn, Shift sprint\n"
+            f"{self._body_clip_number_text()}"
+        )
