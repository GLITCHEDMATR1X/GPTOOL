+    def enable_body_mode(self, enabled=True, requested_clip=None):
+        self.body_mode = bool(enabled)
+        if self.body_mode:
+            if requested_clip and (self.body_actor is None or not _clip_matches(requested_clip, self.animation_clips[self.current_clip_index]["name"])):
