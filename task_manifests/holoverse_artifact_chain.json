{
  "schema": "gptool.task.v1",
  "id": "holoverse_artifact_chain_smoke",
  "title": "HoloVerse artifact chain smoke journey",
  "requires_approval": false,
  "steps": [
    {"action": "note", "label": "intent", "message": "Validate that HoloVerse artifact routes still launch and return cleanly."},
    {"action": "assert_file_exists", "label": "HoloVerse main exists", "path": "${holoverse}/main.py", "block_on_fail": false},
    {"action": "command", "label": "compile HoloVerse", "cmd": "python -m compileall -q .", "cwd": "${holoverse}", "timeout": 180, "run_in_dry_run": false, "block_on_fail": true},
    {"action": "command", "label": "route validator", "cmd": "python tools/validate_holoverse_routes.py", "cwd": "${holoverse}", "timeout": 120, "run_in_dry_run": false, "block_on_fail": true},
    {"action": "command", "label": "artifact route smoke", "cmd": "python main.py --self-test --artifact-route-smoke-test", "cwd": "${holoverse}", "timeout": 180, "run_in_dry_run": false, "block_on_fail": true},
    {"action": "assert_no_junk", "label": "no runtime junk", "path": "${holoverse}", "block_on_fail": false}
  ]
}
